# Copy to .env_local and fill in. config.py loads .env_local at import time.
# Never commit the filled-in file — .env_local is gitignored.

# ── LLM (required) ───────────────────────────────────────────────────────────
# Groq serves both the conversational LLM and the RAG chat model (config.py).
GROQ_API_KEY=

# ── ASR ──────────────────────────────────────────────────────────────────────
# Which backend api.py builds at startup: "nvidia" | "runpod" | "local".
#   nvidia — NVIDIA-hosted whisper-large-v3 over gRPC/NVCF (default)
#   runpod — the self-hosted Whisper worker in asr_worker/
#   local  — transformers in-process; needs GPU torch, dev machines only
ASR_BACKEND=nvidia

# Bearer token for NVIDIA's NVCF endpoint (ASR_BACKEND=nvidia).
ASR_KEY=

# Job-API root of the asr_worker/ RunPod endpoint (ASR_BACKEND=runpod),
# e.g. https://api.runpod.ai/v2/<endpoint-id>  — no trailing /run.
ASR_BASE_URL=
# Falls back to RUNPOD_API_KEY if unset. Distinct from ASR_KEY above.
ASR_RUNPOD_KEY=

# ── TTS ──────────────────────────────────────────────────────────────────────
# Job-API root of the tts_worker/ endpoint (ai4bharat/indic-parler-tts),
# e.g. https://api.runpod.ai/v2/<endpoint-id>  — no trailing /run.
TTS_BASE_URL=
# Falls back to RUNPOD_API_KEY if unset.
TTS_KEY=

# ── RAG embeddings ───────────────────────────────────────────────────────────
# Job-API root of the worker-infinity-embedding endpoint (BAAI/bge-m3),
# e.g. https://api.runpod.ai/v2/<endpoint-id>  — no trailing /runsync.
INFINITY_BASE_URL=
# Falls back to RUNPOD_API_KEY if unset.
INFINITY_API_KEY=

# One key for every RunPod endpoint above, if you don't set them individually.
RUNPOD_API_KEY=

# ── API ──────────────────────────────────────────────────────────────────────
# Extra CORS origins, comma-separated. localhost:3000/3001 are always allowed,
# so this is for the deployed frontend, e.g. https://your-app.vercel.app
CORS_ORIGINS=

# ── Slack live ingestion (optional) ──────────────────────────────────────────
# All three must be set for slack_bot/listener.py to start; leave blank to
# disable. See config.py's SLACK_ENABLED.
SLACK_BOT_TOKEN=      # xoxb-… , needs channels:history + channels:read
SLACK_APP_TOKEN=      # xapp-… , needs connections:write (Socket Mode)
SLACK_CHANNELS=       # "#support,#general" or "C0123,C0456"
